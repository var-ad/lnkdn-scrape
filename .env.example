# LinkedIn credentials
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Gemini
GEMINI_API_KEY=AIza...

# DeepSeek fallback
DEEPSEEK_API_KEY=sk-...

# OpenRouter fallback
OPENROUTER_API_KEY=sk-or-v1-...

# Google Sheets
GOOGLE_SA_JSON=service_account.json    # path to downloaded service account JSON
SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms  # from Sheet URL

# Optional overrides
TIMEZONE=Asia/Kolkata
DAILY_SHEET_TABS=true       # true -> tab like 29-5-2026
# SHEET_TAB_NAME=Jobs       # optional fixed tab name; omit for daily tabs
DATE_FILTER=past-24h        # past-24h | past-week
MAX_SCROLL_ROUNDS=6         # more = more posts per query, slower
SCROLL_DELAY=2.5            # seconds between scrolls
HEADLESS_BROWSER=true       # true for cloud, false for local login/debug
NAVIGATION_TIMEOUT=60000
FEED_WAIT_TIMEOUT=30000
SELECTOR_WAIT_TIMEOUT=20000
LOGIN_WAIT_TIMEOUT=120000
